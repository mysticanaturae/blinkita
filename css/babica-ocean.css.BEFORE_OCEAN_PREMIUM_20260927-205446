/* =========================================================
   BLINKITA — LEGEND OF GRANDMOTHER OCEAN
   Premium Caribbean / VIP service presentation
   ========================================================= */

.ocean-legend-page{
  --ocean-ink:#073f50;
  --ocean-deep:#062f3c;
  --ocean-teal:#0c7180;
  --ocean-mist:#eaf7f6;
  --ocean-sand:#d8b878;
  --ocean-gold:#b88932;
  --ocean-white:#fffdf8;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(255,255,255,.98) 0%,
      rgba(233,248,247,.92) 42%,
      rgba(207,237,235,.96) 100%
    );

  color:var(--ocean-ink);
}

.ocean-legend-page .ocean-shell{
  width:min(1120px,calc(100% - 36px));
  margin:0 auto;
  padding:150px 0 90px;
}

.ocean-legend-page .ocean-kicker{
  text-align:center;
  letter-spacing:.28em;
  text-transform:uppercase;
  font-size:11px;
  font-weight:700;
  color:var(--ocean-gold);
  margin-bottom:18px;
}

.ocean-legend-page .ocean-title{
  max-width:920px;
  margin:0 auto;
  text-align:center;
  font-family:"Cormorant Garamond",Georgia,serif;
  font-size:clamp(54px,8vw,112px);
  line-height:.82;
  font-weight:400;
  letter-spacing:-.045em;
  color:var(--ocean-deep);
}

.ocean-legend-page .ocean-subtitle{
  max-width:720px;
  margin:28px auto 0;
  text-align:center;
  font-size:17px;
  line-height:1.8;
  color:#456875;
}

.ocean-legend-page .ocean-hero-rule{
  width:110px;
  height:1px;
  margin:34px auto 0;
  background:
    linear-gradient(
      90deg,
      transparent,
      var(--ocean-gold),
      transparent
    );
}

.ocean-legend-page .ocean-story{
  max-width:860px;
  margin:90px auto 0;
}

.ocean-legend-page .ocean-chapter{
  margin:0 0 34px;
  padding:42px 46px;
  border:1px solid rgba(184,137,50,.24);
  border-radius:28px;
  background:rgba(255,255,255,.62);
  box-shadow:0 22px 65px rgba(7,63,80,.07);
  backdrop-filter:blur(10px);
}

.ocean-legend-page .ocean-chapter-number{
  margin-bottom:12px;
  font-size:11px;
  font-weight:700;
  letter-spacing:.22em;
  color:var(--ocean-gold);
  text-transform:uppercase;
}

.ocean-legend-page .ocean-chapter h2{
  margin:0 0 24px;
  font-family:"Cormorant Garamond",Georgia,serif;
  font-size:clamp(32px,4vw,48px);
  line-height:1;
  font-weight:500;
  color:var(--ocean-deep);
}

.ocean-legend-page .ocean-copy{
  margin:0;
  font-size:17px;
  line-height:1.9;
  color:#355d68;
}

.ocean-legend-page .ocean-copy p{
  margin:0 0 20px;
}

.ocean-legend-page .ocean-copy p:last-child{
  margin-bottom:0;
}

.ocean-legend-page .ocean-copy strong{
  color:var(--ocean-deep);
  font-weight:700;
}

.ocean-legend-page .ocean-quote{
  margin:26px 0 0;
  padding:26px 30px;
  border-left:2px solid var(--ocean-gold);
  background:
    linear-gradient(
      90deg,
      rgba(216,184,120,.13),
      transparent
    );

  font-family:"Cormorant Garamond",Georgia,serif;
  font-size:27px;
  line-height:1.25;
  color:var(--ocean-deep);
}

.ocean-legend-page .ocean-service{
  position:relative;
  overflow:hidden;
  margin:90px auto 50px;
  padding:58px 58px 54px;
  max-width:980px;

  border-radius:34px;

  background:
    radial-gradient(
      circle at 85% 10%,
      rgba(216,184,120,.24),
      transparent 30%
    ),
    linear-gradient(
      145deg,
      #073f50 0%,
      #062f3c 58%,
      #075b67 100%
    );

  color:#fff;

  box-shadow:0 30px 90px rgba(4,47,60,.24);

  border:1px solid rgba(216,184,120,.45);
}

.ocean-legend-page .ocean-service:before{
  content:"";
  position:absolute;

  width:280px;
  height:280px;

  right:-100px;
  bottom:-130px;

  border-radius:50%;

  border:1px solid rgba(255,255,255,.14);

  box-shadow:
    0 0 0 35px rgba(255,255,255,.025),
    0 0 0 70px rgba(255,255,255,.018);
}

.ocean-legend-page .service-label{
  position:relative;
  display:inline-block;

  margin-bottom:18px;
  padding:8px 13px;

  border:1px solid rgba(216,184,120,.45);
  border-radius:999px;

  color:#e9d19a;

  font-size:10px;
  font-weight:700;
  letter-spacing:.2em;
  text-transform:uppercase;
}

.ocean-legend-page .ocean-service h2{
  position:relative;

  max-width:760px;
  margin:0 0 18px;

  font-family:"Cormorant Garamond",Georgia,serif;
  font-size:clamp(38px,5vw,64px);
  line-height:.98;
  font-weight:400;

  color:#fffdf8;
}

.ocean-legend-page .ocean-service .service-lead{
  position:relative;

  max-width:720px;
  margin:0 0 28px;

  font-size:18px;
  line-height:1.75;

  color:rgba(255,255,255,.82);
}

.ocean-legend-page .service-points{
  position:relative;

  display:grid;
  grid-template-columns:repeat(3,1fr);

  gap:12px;
  margin:30px 0;
}

.ocean-legend-page .service-point{
  padding:18px;

  border:1px solid rgba(255,255,255,.13);
  border-radius:18px;

  background:rgba(255,255,255,.055);

  color:rgba(255,255,255,.9);

  font-size:13px;
  line-height:1.55;
}

.ocean-legend-page .service-point strong{
  display:block;

  margin-bottom:6px;

  color:#e9d19a;

  font-size:11px;
  letter-spacing:.12em;
  text-transform:uppercase;
}

.ocean-legend-page .ocean-cta{
  position:relative;

  display:flex;
  flex-wrap:wrap;
  align-items:center;

  gap:16px;
  margin-top:32px;
}

.ocean-legend-page .ocean-cta a{
  display:inline-flex;

  align-items:center;
  justify-content:center;

  min-height:52px;
  padding:0 28px;

  border-radius:999px;

  text-decoration:none;

  font-size:12px;
  font-weight:800;
  letter-spacing:.14em;
  text-transform:uppercase;

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}

.ocean-legend-page .ocean-cta a.primary{
  background:#e0c487;
  color:#073f50;

  box-shadow:0 12px 30px rgba(0,0,0,.18);
}

.ocean-legend-page .ocean-cta a.secondary{
  border:1px solid rgba(255,255,255,.28);

  color:#fff;

  background:rgba(255,255,255,.04);
}

.ocean-legend-page .ocean-cta a:hover{
  transform:translateY(-2px);

  box-shadow:0 16px 34px rgba(0,0,0,.22);
}

.ocean-legend-page .ocean-note{
  max-width:780px;

  margin:0 auto;

  text-align:center;

  color:#577680;

  font-size:13px;
  line-height:1.7;
}

.ocean-legend-page .ocean-signature{
  margin:55px auto 0;

  text-align:center;

  font-family:"Cormorant Garamond",Georgia,serif;

  font-size:25px;

  color:var(--ocean-deep);
}

.ocean-legend-page .ocean-signature span{
  display:block;

  margin-top:8px;

  font-family:"DM Sans",Arial,sans-serif;

  font-size:10px;

  letter-spacing:.2em;

  text-transform:uppercase;

  color:var(--ocean-gold);
}

@media(max-width:760px){

  .ocean-legend-page .ocean-shell{
    width:min(100% - 22px,680px);
    padding-top:125px;
  }

  .ocean-legend-page .ocean-chapter{
    padding:30px 24px;
    border-radius:22px;
  }

  .ocean-legend-page .ocean-service{
    padding:38px 26px;
    border-radius:26px;
  }

  .ocean-legend-page .service-points{
    grid-template-columns:1fr;
  }

  .ocean-legend-page .ocean-title{
    font-size:clamp(48px,15vw,76px);
  }

  .ocean-legend-page .ocean-copy{
    font-size:16px;
    line-height:1.8;
  }

  .ocean-legend-page .ocean-quote{
    padding:22px 20px;
    font-size:24px;
  }

  .ocean-legend-page .ocean-cta{
    align-items:stretch;
    flex-direction:column;
  }

  .ocean-legend-page .ocean-cta a{
    width:100%;
  }
}
