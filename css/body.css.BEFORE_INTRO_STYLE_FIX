body.page-body{--cream:#f1f2e7;--gold:#8d9566}

/* =========================================================
   BLINKITA BODY � PREMIUM HERO INTRO
========================================================= */

.body-hero-copy .hero-tagline {
  margin-top: 0.8rem;
  margin-bottom: 3.5rem;
  font-size: 1.15rem;
  line-height: 1.6;
  color: #52606a;
}

.body-intro {
  max-width: 720px;
}

.body-intro h2 {
  margin: 0 0 1.5rem;
  font-size: clamp(2.5rem, 5vw, 4.8rem);
  line-height: 0.98;
  letter-spacing: -0.035em;
}

.body-intro h2 em {
  font-style: italic;
}

.body-intro .hero-lead {
  margin-bottom: 1.25rem;
}

.body-intro p {
  max-width: 680px;
}

@media (max-width: 800px) {

  .body-hero-copy .hero-tagline {
    margin-bottom: 2.5rem;
  }

  .body-intro h2 {
    font-size: clamp(2.3rem, 11vw, 4rem);
  }

}

/* =========================================================
   BLINKITA BODY · INTRO
   Samostojna premium sekcija med HERO in THE BODY REMEMBERS
========================================================= */

.body-intro {
  position: relative;
  width: 100%;
  padding: 110px 7vw 115px;
  margin: 0;
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,0.98) 0%,
      rgba(248,244,236,0.98) 100%
    );
  border-top: 1px solid rgba(120,95,65,0.10);
  border-bottom: 1px solid rgba(120,95,65,0.10);
  box-sizing: border-box;
}

.body-intro-inner {
  width: min(1080px, 100%);
  margin: 0 auto;
}

.body-intro .eyebrow {
  margin-bottom: 22px;
  letter-spacing: 0.18em;
  font-size: 0.72rem;
  text-transform: uppercase;
  opacity: 0.68;
}

.body-intro h2 {
  max-width: 850px;
  margin: 0 0 42px;
  font-size: clamp(2.4rem, 5vw, 4.8rem);
  line-height: 1.02;
  font-weight: 500;
  letter-spacing: -0.035em;
}

.body-intro h2 em {
  font-style: italic;
  font-weight: 400;
}

.body-intro-text {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 70px;
  max-width: 940px;
}

.body-intro-text p {
  margin: 0;
  font-size: 1.05rem;
  line-height: 1.85;
  color: rgba(35,30,25,0.78);
}

.body-intro-text p + p {
  margin-top: 0;
}


/* =========================================================
   THE BODY REMEMBERS
   Vedno vizualno ločen od uvoda
========================================================= */

.body-philosophy {
  position: relative;
  padding: 115px 7vw 125px;
  margin: 0;
  box-sizing: border-box;
}

.body-philosophy .eyebrow {
  margin-bottom: 22px;
}

.body-philosophy h2 {
  max-width: 900px;
  margin-bottom: 55px;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 760px) {

  .body-intro {
    padding: 75px 7vw 80px;
  }

  .body-intro h2 {
    font-size: clamp(2.25rem, 11vw, 3.5rem);
    margin-bottom: 32px;
  }

  .body-intro-text {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .body-intro-text p {
    font-size: 1rem;
    line-height: 1.75;
  }

  .body-philosophy {
    padding: 80px 7vw 90px;
  }

}