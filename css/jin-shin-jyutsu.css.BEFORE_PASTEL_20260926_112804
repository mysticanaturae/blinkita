/* ============================================================
   BLINKITA BODY · JIN SHIN JYUTSU
============================================================ */

.jsj-page {
  --jsj-gold: #c8a96b;
  --jsj-cream: #f5f0e7;
  --jsj-dark: #151714;
  --jsj-muted: #77756d;
  --jsj-line: rgba(200,169,107,.28);
}

.jsj-page-wrap {
  overflow: hidden;
}

.jsj-hero {
  min-height: 78vh;
  padding: 110px 6vw 90px;
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: 60px;
  align-items: center;
  background:
    radial-gradient(circle at 80% 30%, rgba(200,169,107,.18), transparent 32%),
    linear-gradient(135deg,#151714,#20231e);
  color: #f5f0e7;
}

.jsj-hero-copy {
  max-width: 850px;
}

.jsj-hero h1 {
  font-size: clamp(4rem,9vw,9rem);
  line-height: .86;
  font-weight: 300;
  margin: 25px 0 35px;
  letter-spacing: -.04em;
}

.jsj-hero h1 em,
.jsj-hero h2 em {
  color: var(--jsj-gold);
  font-style: italic;
}

.jsj-lead {
  font-size: clamp(1.4rem,2.5vw,2.1rem);
  line-height: 1.35;
  max-width: 650px;
}

.jsj-intro {
  max-width: 650px;
  line-height: 1.85;
  opacity: .72;
}

.jsj-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 35px;
}

.jsj-button {
  display: inline-block;
  padding: 14px 22px;
  border: 1px solid var(--jsj-gold);
  color: var(--jsj-gold);
  text-decoration: none;
  font-size: .72rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  transition: .3s ease;
}

.jsj-button:hover,
.jsj-button-primary {
  background: var(--jsj-gold);
  color: #171815;
}

.jsj-symbol {
  display: flex;
  justify-content: center;
  align-items: center;
}

.jsj-symbol-ring {
  width: min(34vw,390px);
  height: min(34vw,390px);
  min-width: 270px;
  min-height: 270px;
  border: 1px solid rgba(200,169,107,.45);
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--jsj-gold);
  letter-spacing: .18em;
  font-size: .65rem;
}

.jsj-symbol-ring:before,
.jsj-symbol-ring:after {
  content:"";
  position:absolute;
  border:1px solid rgba(200,169,107,.18);
  border-radius:50%;
}

.jsj-symbol-ring:before {
  inset: 35px;
}

.jsj-symbol-ring:after {
  inset: 70px;
}

.jsj-symbol-ring span {
  position:absolute;
}

.jsj-symbol-ring span:nth-child(1){top:18px}
.jsj-symbol-ring span:nth-child(2){right:8px;top:48%}
.jsj-symbol-ring span:nth-child(3){bottom:18px}
.jsj-symbol-ring span:nth-child(4){left:-15px;top:48%}

.jsj-about,
.jsj-practitioner,
.jsj-breath,
.jsj-therapeutic,
.jsj-safety,
.jsj-cta {
  padding: 110px 6vw;
}

.jsj-about {
  background: var(--jsj-cream);
  color: #20211d;
}

.jsj-section-label {
  font-size: .68rem;
  letter-spacing: .17em;
  text-transform: uppercase;
  color: var(--jsj-gold);
}

.jsj-about-grid,
.jsj-breath-grid {
  max-width: 1200px;
  margin: 50px auto 0;
  display:grid;
  grid-template-columns: .9fr 1.1fr;
  gap: 90px;
}

.jsj-about h2,
.jsj-breath h2,
.jsj-therapeutic h2,
.jsj-cta h2 {
  font-size: clamp(2.8rem,6vw,6rem);
  line-height: .95;
  font-weight: 300;
  margin: 20px 0;
}

.jsj-copy {
  line-height: 1.85;
  max-width: 760px;
}

.jsj-copy p {
  margin: 0 0 25px;
}

.jsj-emphasis {
  color: #9b7d3e;
  font-size: 1.2rem;
}

.jsj-practitioner {
  background: #ebe5d8;
  color:#20211d;
}

.jsj-practitioner-inner,
.jsj-safety-inner {
  max-width: 850px;
  margin:auto;
}

.jsj-practitioner h2 {
  font-size: clamp(2.7rem,5vw,5rem);
  font-weight:300;
}

.jsj-practitioner p,
.jsj-safety p {
  max-width: 760px;
  line-height:1.85;
}

.jsj-now {
  padding:120px 6vw;
  background:#171815;
  color:#f5f0e7;
}

.jsj-section-heading {
  max-width:1200px;
  margin:0 auto 60px;
  display:grid;
  grid-template-columns:1.2fr .8fr;
  gap:70px;
  align-items:end;
}

.jsj-section-heading h2 {
  font-size:clamp(3rem,6vw,6rem);
  line-height:.92;
  font-weight:300;
  margin:18px 0 0;
}

.jsj-section-heading h2 em {
  color:var(--jsj-gold);
  font-style:italic;
}

.jsj-section-heading > p {
  line-height:1.8;
  opacity:.7;
}

.jsj-now-grid {
  max-width:1200px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
}

.jsj-now-card {
  min-height:210px;
  text-align:left;
  padding:28px;
  border:1px solid rgba(200,169,107,.3);
  background:rgba(255,255,255,.025);
  color:#f5f0e7;
  cursor:pointer;
  transition:.3s ease;
}

.jsj-now-card:hover,
.jsj-now-card.active {
  transform:translateY(-4px);
  border-color:var(--jsj-gold);
  background:rgba(200,169,107,.08);
}

.jsj-now-card span {
  display:block;
  color:var(--jsj-gold);
  font-size:.7rem;
  letter-spacing:.12em;
}

.jsj-now-card strong {
  display:block;
  margin:45px 0 10px;
  font-size:1.05rem;
  letter-spacing:.06em;
}

.jsj-now-card small {
  opacity:.58;
  line-height:1.5;
}

.jsj-fingers {
  padding:120px 6vw;
  background:#eee8dc;
  color:#20211d;
}

.finger-grid {
  max-width:1200px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:14px;
}

.finger-card {
  min-height:210px;
  padding:28px;
  text-align:left;
  border:1px solid rgba(32,33,29,.15);
  background:rgba(255,255,255,.45);
  cursor:pointer;
  transition:.3s ease;
}

.finger-card:hover,
.finger-card.active {
  border-color:var(--jsj-gold);
  transform:translateY(-4px);
}

.finger-number {
  color:#9b7d3e;
  display:block;
}

.finger-card strong {
  display:block;
  margin-top:55px;
  font-size:1rem;
}

.finger-card small {
  color:#77756d;
}

.finger-info {
  max-width:1200px;
  margin:25px auto 0;
  min-height:150px;
  padding:35px;
  border:1px solid rgba(32,33,29,.13);
  background:#f7f3eb;
}

.finger-info-placeholder {
  display:flex;
  gap:25px;
  align-items:center;
  color:#77756d;
}

.finger-info-placeholder span {
  font-size:2rem;
  color:var(--jsj-gold);
}

.jsj-breath {
  background:#151714;
  color:#f5f0e7;
}

.time-scale {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  margin-top:35px;
}

.time-scale div {
  border-top:1px solid var(--jsj-line);
  padding-top:20px;
}

.time-scale strong {
  display:block;
  font-size:2rem;
  color:var(--jsj-gold);
  font-weight:300;
}

.time-scale span,
.time-scale small {
  display:block;
  font-size:.65rem;
  letter-spacing:.12em;
  text-transform:uppercase;
  margin-top:5px;
}

.time-scale small {
  opacity:.55;
}

.jsj-library {
  padding:120px 6vw;
  background:#f5f0e7;
  color:#20211d;
}

.protocol-grid {
  max-width:1200px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.protocol-card {
  padding:32px;
  min-height:280px;
  border:1px solid rgba(32,33,29,.14);
  background:rgba(255,255,255,.45);
}

.protocol-card > span:first-child {
  color:#9b7d3e;
  font-size:.7rem;
  letter-spacing:.12em;
}

.protocol-card h3 {
  font-size:1.65rem;
  font-weight:400;
  margin:35px 0 15px;
}

.protocol-card p {
  line-height:1.7;
  color:#68665e;
}

.protocol-meta {
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-top:25px;
}

.protocol-meta b {
  font-size:.62rem;
  letter-spacing:.1em;
  color:#9b7d3e;
  border:1px solid rgba(155,125,62,.35);
  padding:6px 8px;
}

.protocol-status {
  display:block;
  margin-top:22px;
  color:#99958b;
  font-size:.62rem;
  letter-spacing:.13em;
  text-transform:uppercase;
}

.jsj-therapeutic {
  background:#ebe5d8;
  color:#20211d;
}

.therapy-meta {
  display:flex;
  flex-wrap:wrap;
  gap:9px;
  margin-top:30px;
}

.therapy-meta span {
  border:1px solid rgba(155,125,62,.4);
  padding:8px 12px;
  font-size:.65rem;
  letter-spacing:.11em;
  color:#8d7138;
}

.jsj-safety {
  background:#20221e;
  color:#f5f0e7;
}

.jsj-safety h2 {
  font-size:clamp(2.5rem,5vw,5rem);
  font-weight:300;
}

.jsj-safety h2 em {
  color:var(--jsj-gold);
}

.jsj-safety-final {
  color:var(--jsj-gold);
  font-size:1.2rem;
}

.jsj-cta {
  background:
    radial-gradient(circle at 80% 20%,rgba(200,169,107,.18),transparent 30%),
    #171815;
  color:#f5f0e7;
  text-align:center;
}

.jsj-cta > div {
  max-width:800px;
  margin:auto;
}

.jsj-cta p {
  max-width:650px;
  margin:0 auto 35px;
  line-height:1.8;
  opacity:.7;
}

@media(max-width:900px){

  .jsj-hero,
  .jsj-about-grid,
  .jsj-breath-grid,
  .jsj-section-heading {
    grid-template-columns:1fr;
  }

  .jsj-symbol {
    display:none;
  }

  .jsj-now-grid {
    grid-template-columns:repeat(2,1fr);
  }

  .finger-grid {
    grid-template-columns:repeat(2,1fr);
  }

  .protocol-grid {
    grid-template-columns:1fr 1fr;
  }
}

@media(max-width:600px){

  .jsj-hero,
  .jsj-about,
  .jsj-practitioner,
  .jsj-now,
  .jsj-fingers,
  .jsj-breath,
  .jsj-library,
  .jsj-therapeutic,
  .jsj-safety,
  .jsj-cta {
    padding-left:6vw;
    padding-right:6vw;
  }

  .jsj-now-grid,
  .finger-grid,
  .protocol-grid,
  .time-scale {
    grid-template-columns:1fr;
  }

  .jsj-hero h1 {
    font-size:clamp(3.5rem,17vw,6rem);
  }

  .finger-card,
  .jsj-now-card {
    min-height:170px;
  }
}
