/* ==========================================================
   BLINKITA · BABICA OCEAN
   PREMIUM YOUNIQUE / AQUA SYSTEM
   ========================================================== */

:root {
    --ocean-deep: #06151c;
    --ocean-night: #081f29;
    --ocean-blue: #0c3b49;
    --ocean-teal: #12606a;
    --ocean-aqua: #6fd3cf;
    --ocean-aqua-soft: #a8e5df;
    --ocean-pearl: #f2f0e8;
    --ocean-sand: #d9c9a6;
    --ocean-gold: #c7a96b;
    --ocean-white: #f8f7f1;

    --serif: "Cormorant Garamond", Georgia, serif;
    --sans: "DM Sans", Arial, sans-serif;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body.ocean-body {
    margin: 0;
    background: var(--ocean-deep);
    color: var(--ocean-pearl);
    font-family: var(--sans);
    overflow-x: hidden;
}

.ocean-legend-page {
    width: 100%;
    overflow: hidden;
    background:
        radial-gradient(
            circle at 75% 15%,
            rgba(111,211,207,.12),
            transparent 28%
        ),
        linear-gradient(
            180deg,
            #06151c 0%,
            #092631 38%,
            #06171f 100%
        );
}

/* ==========================================================
   TYPOGRAPHY
   ========================================================== */

.ocean-kicker {
    font-family: var(--sans);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: .30em;
    text-transform: uppercase;
    color: var(--ocean-aqua);
}

.ocean-legend-page h1,
.ocean-legend-page h2,
.ocean-legend-page p {
    margin-top: 0;
}

/* ==========================================================
   HERO
   ========================================================== */

.ocean-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
        radial-gradient(
            ellipse at 50% 105%,
            rgba(53,159,166,.52),
            transparent 45%
        ),
        radial-gradient(
            ellipse at 15% 35%,
            rgba(35,112,129,.24),
            transparent 38%
        ),
        linear-gradient(
            180deg,
            #041117 0%,
            #082a35 58%,
            #0a4650 100%
        );
}

.ocean-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .32;
    background:
        repeating-radial-gradient(
            ellipse at 50% 120%,
            transparent 0 18px,
            rgba(160,235,228,.055) 19px 20px,
            transparent 21px 42px
        );
    transform: scale(1.7);
    animation: oceanDrift 18s ease-in-out infinite alternate;
}

@keyframes oceanDrift {
    from {
        transform: scale(1.7) translate3d(-1%,0,0);
    }
    to {
        transform: scale(1.78) translate3d(1%,2%,0);
    }
}

.ocean-hero-atmosphere {
    position: absolute;
    width: 75vw;
    height: 75vw;
    max-width: 1000px;
    max-height: 1000px;
    border-radius: 50%;
    border: 1px solid rgba(168,229,223,.10);
    box-shadow:
        0 0 160px rgba(111,211,207,.08),
        inset 0 0 100px rgba(111,211,207,.04);
}

.ocean-hero-orbit {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(199,169,107,.15);
    pointer-events: none;
}

.orbit-one {
    width: 44vw;
    height: 44vw;
    max-width: 680px;
    max-height: 680px;
    transform: rotate(-18deg) scaleX(1.55);
}

.orbit-two {
    width: 58vw;
    height: 58vw;
    max-width: 850px;
    max-height: 850px;
    transform: rotate(22deg) scaleX(1.5);
    border-color: rgba(111,211,207,.08);
}

.ocean-hero-content {
    position: relative;
    z-index: 5;
    width: min(1200px, 90vw);
    text-align: center;
}

.ocean-hero-content h1 {
    margin: 28px 0 30px;
    font-family: var(--serif);
    font-size: clamp(62px, 10vw, 154px);
    font-weight: 300;
    line-height: .78;
    letter-spacing: -.045em;
    color: var(--ocean-white);
}

.ocean-hero-content h1 em {
    display: inline-block;
    font-style: italic;
    color: var(--ocean-aqua-soft);
}

.ocean-hero-line {
    width: 90px;
    height: 1px;
    margin: 0 auto 28px;
    background: linear-gradient(
        90deg,
        transparent,
        var(--ocean-gold),
        transparent
    );
}

.ocean-hero-content p {
    font-family: var(--serif);
    font-size: clamp(22px, 2.7vw, 38px);
    font-weight: 300;
    line-height: 1.15;
    color: rgba(248,247,241,.90);
}

.ocean-hero-content small {
    display: block;
    margin-top: 26px;
    font-size: 10px;
    letter-spacing: .23em;
    text-transform: uppercase;
    color: rgba(242,240,232,.48);
}

.ocean-hero-scroll {
    position: absolute;
    z-index: 8;
    left: 50%;
    bottom: 34px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(242,240,232,.48);
    font-size: 8px;
    letter-spacing: .35em;
}

.ocean-hero-scroll i {
    width: 1px;
    height: 44px;
    background: linear-gradient(
        180deg,
        var(--ocean-aqua),
        transparent
    );
}

/* ==========================================================
   INTRO
   ========================================================== */

.ocean-intro {
    width: min(1320px, 88vw);
    margin: 0 auto;
    padding: 150px 0 170px;
    display: grid;
    grid-template-columns: 1fr 4fr 1fr;
    gap: 50px;
    align-items: start;
}

.ocean-intro-number {
    font-size: 10px;
    letter-spacing: .25em;
    color: rgba(242,240,232,.34);
}

.ocean-intro-main {
    max-width: 920px;
}

.ocean-intro-lead {
    margin-top: 34px;
    font-family: var(--serif);
    font-size: clamp(36px, 5vw, 70px);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -.025em;
    color: var(--ocean-white);
}

.ocean-intro-aside {
    padding-top: 8px;
    font-size: 9px;
    line-height: 1.8;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: rgba(242,240,232,.42);
}

.ocean-intro-aside span {
    color: var(--ocean-aqua);
}

/* ==========================================================
   STORY
   ========================================================== */

.ocean-story {
    position: relative;
}

.ocean-section {
    position: relative;
    width: min(1240px, 88vw);
    min-height: 78vh;
    margin: 0 auto;
    display: grid;
    align-items: center;
    padding: 130px 0;
}

.ocean-section-left {
    grid-template-columns: 1fr 1.5fr;
}

.ocean-section-right {
    grid-template-columns: 1.5fr 1fr;
}

.ocean-section-right .ocean-section-content {
    grid-column: 2;
}

.ocean-section-mark {
    position: absolute;
    top: 70px;
    left: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    color: rgba(242,240,232,.28);
    font-size: 9px;
    letter-spacing: .25em;
}

.ocean-section-mark i {
    width: 55px;
    height: 1px;
    background: rgba(111,211,207,.35);
}

.ocean-word {
    position: absolute;
    z-index: 0;
    left: -8vw;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--serif);
    font-size: clamp(100px, 19vw, 300px);
    line-height: .7;
    white-space: nowrap;
    color: rgba(111,211,207,.035);
    letter-spacing: -.06em;
    pointer-events: none;
}

.ocean-section-right .ocean-word {
    left: auto;
    right: -8vw;
}

.ocean-section-content {
    position: relative;
    z-index: 2;
    max-width: 700px;
}

.ocean-section-content h2 {
    margin: 24px 0 34px;
    font-family: var(--serif);
    font-size: clamp(42px, 5.5vw, 82px);
    line-height: .93;
    font-weight: 300;
    letter-spacing: -.035em;
    color: var(--ocean-white);
}

.ocean-copy {
    max-width: 610px;
}

.ocean-copy p {
    margin: 0 0 23px;
    font-family: var(--serif);
    font-size: clamp(19px, 2vw, 25px);
    font-weight: 300;
    line-height: 1.48;
    color: rgba(242,240,232,.70);
}

.ocean-copy strong {
    color: var(--ocean-aqua-soft);
    font-weight: 500;
}

/* ==========================================================
   NAME / TURNING POINT
   ========================================================== */

.ocean-name-section {
    position: relative;
    margin: 100px 0 80px;
    padding: 180px 8vw;
    background:
        radial-gradient(
            circle at 50% 50%,
            rgba(111,211,207,.15),
            transparent 42%
        ),
        linear-gradient(
            135deg,
            #0a313d,
            #06151c
        );
    border-top: 1px solid rgba(111,211,207,.12);
    border-bottom: 1px solid rgba(111,211,207,.12);
    overflow: hidden;
}

.ocean-name-section::before,
.ocean-name-section::after {
    content: "";
    position: absolute;
    border: 1px solid rgba(199,169,107,.12);
    border-radius: 50%;
    pointer-events: none;
}

.ocean-name-section::before {
    width: 60vw;
    height: 25vw;
    left: 20vw;
    top: 25%;
    transform: rotate(-18deg);
}

.ocean-name-section::after {
    width: 45vw;
    height: 20vw;
    left: 28vw;
    top: 35%;
    transform: rotate(14deg);
}

.ocean-name-inner {
    position: relative;
    z-index: 2;
    width: min(980px, 88vw);
    margin: auto;
}

.ocean-name-line {
    width: 120px;
    height: 1px;
    margin: 28px 0 35px;
    background: var(--ocean-gold);
}

.ocean-name-inner h2 {
    font-family: var(--serif);
    font-size: clamp(54px, 8vw, 120px);
    line-height: .86;
    font-weight: 300;
    letter-spacing: -.045em;
    color: var(--ocean-white);
}

.ocean-name-inner h2 em {
    color: var(--ocean-aqua);
}

.ocean-name-copy {
    width: min(630px, 100%);
    margin-top: 55px;
}

.ocean-name-copy p {
    margin: 0 0 22px;
    font-family: var(--serif);
    font-size: clamp(20px, 2vw, 27px);
    line-height: 1.45;
    color: rgba(242,240,232,.72);
}

.ocean-name-sign {
    margin-top: 65px;
    font-size: 9px;
    letter-spacing: .28em;
    color: rgba(242,240,232,.40);
}

/* ==========================================================
   RITUAL FLOW
   ========================================================== */

.ocean-ritual-section {
    width: min(1400px, 92vw);
    margin: 0 auto;
    padding: 160px 0;
}

.ocean-ritual-header {
    max-width: 820px;
    margin-bottom: 100px;
}

.ocean-ritual-header h2 {
    margin: 24px 0;
    font-family: var(--serif);
    font-size: clamp(52px, 7vw, 100px);
    line-height: .88;
    font-weight: 300;
    letter-spacing: -.04em;
}

.ocean-ritual-header p {
    max-width: 620px;
    font-family: var(--serif);
    font-size: 23px;
    line-height: 1.45;
    color: rgba(242,240,232,.60);
}

.ocean-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
}

.ocean-flow-item {
    min-width: 125px;
    text-align: center;
}

.ocean-flow-item span {
    display: block;
    margin-bottom: 14px;
    font-size: 8px;
    letter-spacing: .22em;
    color: var(--ocean-gold);
}

.ocean-flow-item strong {
    font-family: var(--sans);
    font-size: 9px;
    letter-spacing: .15em;
    font-weight: 500;
    color: rgba(242,240,232,.76);
}

.ocean-flow-line {
    width: 35px;
    height: 1px;
    background: rgba(111,211,207,.25);
}

/* ==========================================================
   QUOTE
   ========================================================== */

.ocean-quote-section {
    padding: 210px 8vw;
    text-align: center;
    background:
        radial-gradient(
            ellipse at center,
            rgba(111,211,207,.11),
            transparent 50%
        );
}

.ocean-quote {
    display: flex;
    flex-direction: column;
    font-family: var(--serif);
    font-size: clamp(48px, 9vw, 140px);
    line-height: .75;
    font-weight: 300;
    letter-spacing: -.05em;
    color: rgba(242,240,232,.88);
}

.ocean-quote em {
    color: var(--ocean-aqua);
    font-style: italic;
}

/* ==========================================================
   OCEAN MESSAGE
   ========================================================== */

.ocean-message-section {
    position: relative;
    padding: 190px 7vw 170px;
    overflow: hidden;
    background:
        radial-gradient(
            circle at 50% 30%,
            rgba(111,211,207,.19),
            transparent 30%
        ),
        radial-gradient(
            circle at 85% 80%,
            rgba(199,169,107,.07),
            transparent 25%
        ),
        linear-gradient(
            180deg,
            #06151c,
            #031015
        );
    border-top: 1px solid rgba(111,211,207,.13);
}

.ocean-message-section::before {
    content: "";
    position: absolute;
    width: 85vw;
    height: 38vw;
    left: 7.5vw;
    top: 15%;
    border: 1px solid rgba(111,211,207,.07);
    border-radius: 50%;
    transform: rotate(-12deg);
}

.ocean-message-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    left: 50%;
    top: 25%;
    transform: translate(-50%,-50%);
    border-radius: 50%;
    background: rgba(111,211,207,.055);
    filter: blur(60px);
}

.ocean-message-inner {
    position: relative;
    z-index: 3;
    width: min(1050px, 90vw);
    margin: auto;
}

.ocean-message-eyebrow {
    margin-top: 40px;
    font-size: 9px;
    line-height: 1.7;
    letter-spacing: .28em;
    color: rgba(242,240,232,.40);
}

.ocean-message-inner h2 {
    margin: 30px 0;
    font-family: var(--serif);
    font-size: clamp(80px, 15vw, 210px);
    line-height: .70;
    font-weight: 300;
    letter-spacing: -.055em;
    color: var(--ocean-white);
}

.ocean-message-inner h2 em {
    color: var(--ocean-aqua);
    font-style: italic;
}

.ocean-message-rule {
    width: 150px;
    height: 1px;
    margin: 55px 0;
    background: linear-gradient(
        90deg,
        var(--ocean-gold),
        transparent
    );
}

.ocean-message-lead {
    width: min(720px, 100%);
    font-family: var(--serif);
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.16;
    color: rgba(242,240,232,.80);
}

.ocean-message-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 90px 0 65px;
    border-top: 1px solid rgba(242,240,232,.10);
    border-bottom: 1px solid rgba(242,240,232,.10);
}

.ocean-message-details > div {
    padding: 34px 28px 38px;
    border-right: 1px solid rgba(242,240,232,.10);
}

.ocean-message-details > div:last-child {
    border-right: 0;
}

.ocean-message-details span {
    display: block;
    margin-bottom: 30px;
    font-size: 8px;
    letter-spacing: .25em;
    color: var(--ocean-gold);
}

.ocean-message-details strong {
    display: block;
    margin-bottom: 12px;
    font-family: var(--serif);
    font-size: 27px;
    font-weight: 400;
}

.ocean-message-details p {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    color: rgba(242,240,232,.48);
}

.ocean-primary-cta {
    display: inline-flex;
    align-items: center;
    gap: 35px;
    padding: 18px 25px 18px 28px;
    background: var(--ocean-aqua);
    color: #052028;
    text-decoration: none;
    font-size: 10px;
    letter-spacing: .18em;
    font-weight: 600;
    transition:
        transform .3s ease,
        background .3s ease;
}

.ocean-primary-cta span {
    font-size: 20px;
    line-height: 0;
}

.ocean-primary-cta:hover {
    transform: translateY(-3px);
    background: var(--ocean-aqua-soft);
}

.ocean-secondary-cta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-left: 28px;
    color: rgba(242,240,232,.66);
    text-decoration: none;
    font-size: 10px;
    letter-spacing: .16em;
    border-bottom: 1px solid rgba(242,240,232,.22);
    padding-bottom: 8px;
}

.ocean-secondary-cta:hover {
    color: var(--ocean-aqua);
}

.ocean-note {
    max-width: 620px;
    margin-top: 55px;
    font-size: 9px;
    line-height: 1.7;
    color: rgba(242,240,232,.28);
}

/* ==========================================================
   SIGNATURE
   ========================================================== */

.ocean-signature {
    padding: 120px 7vw 150px;
    text-align: center;
    background: #031015;
}

.ocean-signature-line {
    width: 1px;
    height: 80px;
    margin: 0 auto 45px;
    background: linear-gradient(
        180deg,
        var(--ocean-aqua),
        transparent
    );
}

.ocean-signature p {
    font-family: var(--serif);
    font-size: clamp(23px, 3vw, 38px);
    line-height: 1.25;
    font-weight: 300;
    color: rgba(242,240,232,.60);
}

.ocean-signature em {
    color: var(--ocean-aqua);
}

/* ==========================================================
   RESPONSIVE
   ========================================================== */

@media (max-width: 1000px) {

    .ocean-intro {
        grid-template-columns: 1fr;
        gap: 25px;
        padding: 110px 0;
    }

    .ocean-intro-aside {
        display: none;
    }

    .ocean-section {
        min-height: auto;
        padding: 120px 0;
        display: block;
    }

    .ocean-section-right .ocean-section-content {
        grid-column: auto;
    }

    .ocean-section-mark {
        position: relative;
        top: auto;
        margin-bottom: 50px;
    }

    .ocean-word {
        top: 55%;
        opacity: .7;
    }

    .ocean-message-details {
        grid-template-columns: 1fr;
    }

    .ocean-message-details > div {
        border-right: 0;
        border-bottom: 1px solid rgba(242,240,232,.10);
    }

    .ocean-message-details > div:last-child {
        border-bottom: 0;
    }

    .ocean-flow-line {
        display: none;
    }
}

@media (max-width: 620px) {

    .ocean-hero {
        min-height: 92svh;
    }

    .ocean-hero-content {
        width: 88vw;
    }

    .ocean-hero-content h1 {
        font-size: clamp(55px, 16vw, 95px);
    }

    .ocean-hero-content p {
        font-size: 21px;
    }

    .ocean-hero-content p br {
        display: none;
    }

    .ocean-intro {
        padding: 90px 0;
    }

    .ocean-intro-lead {
        font-size: 39px;
    }

    .ocean-section {
        padding: 90px 0;
    }

    .ocean-section-content h2 {
        font-size: 48px;
    }

    .ocean-copy p {
        font-size: 20px;
    }

    .ocean-name-section {
        margin-top: 40px;
        padding: 110px 6vw;
    }

    .ocean-name-inner h2 {
        font-size: 57px;
    }

    .ocean-ritual-section {
        padding: 100px 0;
    }

    .ocean-ritual-header h2 {
        font-size: 57px;
    }

    .ocean-flow {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 45px 20px;
    }

    .ocean-quote-section {
        padding: 130px 5vw;
    }

    .ocean-quote {
        font-size: 54px;
    }

    .ocean-message-section {
        padding: 120px 6vw;
    }

    .ocean-message-inner h2 {
        font-size: 88px;
    }

    .ocean-message-lead {
        font-size: 27px;
    }

    .ocean-message-details {
        margin-top: 65px;
    }

    .ocean-primary-cta {
        width: 100%;
        justify-content: space-between;
    }

    .ocean-secondary-cta {
        margin: 28px 0 0;
    }

    .ocean-signature {
        padding: 90px 7vw 110px;
    }
}

/* ==========================================================
   REDUCE MOTION
   ========================================================== */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    .ocean-hero::after {
        animation: none;
    }

    .ocean-primary-cta {
        transition: none;
    }
}
