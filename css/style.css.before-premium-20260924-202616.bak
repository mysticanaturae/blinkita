:root{--ink:#17352f;--gold:#b79a6b;--cream:#f7f2e8;--mist:#e7eee8;--white:#fffdf8;--line:rgba(23,53,47,.14)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:Georgia,'Times New Roman',serif}a{color:inherit;text-decoration:none}.site-header{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:18px 5vw;background:rgba(247,242,232,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}.brand{font-weight:700;letter-spacing:.14em;font-family:Arial,sans-serif}.brand span{display:block;font-size:9px;letter-spacing:.22em;font-weight:400;margin-top:4px;color:#75684f}.site-header nav{display:flex;gap:22px;font:600 11px Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}.site-header nav a{padding:8px 0;border-bottom:1px solid transparent}.site-header nav a:hover,.site-header nav a.active{border-color:var(--gold)}.nav-toggle{display:none;background:none;border:0;font-size:23px}.hero{min-height:78vh;padding:12vh 8vw 10vh;display:flex;flex-direction:column;justify-content:center;max-width:1100px}.eyebrow{font:700 10px Arial,sans-serif;letter-spacing:.3em;text-transform:uppercase;color:#85734f;margin-bottom:24px}.hero h1{font-size:clamp(48px,8vw,104px);line-height:.94;font-weight:400;margin:0 0 30px;letter-spacing:-.045em}.hero h1 em{color:#8a7042;font-style:normal}.hero p{max-width:640px;font-size:20px;line-height:1.6;margin:0 0 32px}.cta{align-self:flex-start;padding:15px 22px;border:1px solid var(--gold);font:700 11px Arial,sans-serif;letter-spacing:.14em}.portal-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.portal{min-height:310px;padding:32px;display:flex;flex-direction:column;justify-content:flex-end;border-right:1px solid var(--line);transition:.3s}.portal:last-child{border-right:0}.portal:hover{transform:translateY(-5px);background:var(--white)}.portal span{font:11px Arial,sans-serif;color:#897550;margin-bottom:auto}.portal h2{font:700 18px Arial,sans-serif;letter-spacing:.08em;margin:0 0 10px}.portal p{line-height:1.5;margin:0;color:#56665f}.body{background:#edf0e4}.mind{background:#e9e7ee}.time{background:#e9e2d2}.life{background:#e6eee9}.intro{display:grid;grid-template-columns:1fr 1fr;gap:8vw;padding:100px 8vw}.intro h2{font-size:clamp(34px,4vw,58px);font-weight:400;line-height:1.05;margin:0}.intro p{font-size:19px;line-height:1.75;margin:0}footer{padding:28px 5vw;border-top:1px solid var(--line);font:10px Arial,sans-serif;letter-spacing:.12em}@media(max-width:800px){.site-header nav{display:none;position:absolute;top:70px;left:0;right:0;padding:20px 5vw;background:var(--cream);flex-direction:column;border-bottom:1px solid var(--line)}.site-header nav.open{display:flex}.nav-toggle{display:block}.portal-grid{grid-template-columns:1fr 1fr}.portal{border-bottom:1px solid var(--line)}.intro{grid-template-columns:1fr;gap:35px}.hero{padding-top:80px}}

.language-switch{display:flex;gap:.45rem;align-items:center;margin-left:1rem;font-size:.72rem;letter-spacing:.12em}.language-switch a{opacity:.55}.language-switch a.active{opacity:1}.language-entry{min-height:100vh;display:grid;place-items:center;text-align:center}.language-entry main{max-width:760px;padding:3rem}.language-choices{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:2rem}.language-choices .cta{display:inline-block}
